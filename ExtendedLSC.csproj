<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <OutputType>Library</OutputType>
    <AssemblyName>ExtendedLSC</AssemblyName>
    <RootNamespace>ExtendedLSC</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Two builds share this codebase. "Release" = GTA V Legacy (b3788). "Release-Enhanced" defines the ENHANCED
         symbol (GamePlatform.BuiltForEnhanced) for the Enhanced edition (VER_EN_1_0_1013+). Same ScriptHookVDotNet3
         API on both editions; only the raw-memory offsets differ, selected via the ENHANCED compile symbol. -->
    <Configurations>Debug;Release;Release-Enhanced</Configurations>

    <!-- Output directly to GTA V scripts folder for easy testing -->
    <!-- Uncomment and adjust path as needed: -->
    <!-- <OutputPath>C:\Program Files\Rockstar Games\Grand Theft Auto V\scripts\</OutputPath> -->
  </PropertyGroup>

  <!-- Enhanced build: define ENHANCED and output to a separate folder so the Legacy and Enhanced DLLs never
       overwrite each other (both are named ExtendedLSC.dll). Build with: dotnet build -c Release-Enhanced -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release-Enhanced'">
    <DefineConstants>$(DefineConstants);ENHANCED</DefineConstants>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release-Enhanced\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!--
      ScriptHookVDotNet Enhanced - works on BOTH Legacy AND Enhanced Edition
      https://github.com/Chiheb-Bacha/ScriptHookVDotNetEnhanced

      If you only need Legacy, you can swap to:
      <PackageReference Include="ScriptHookVDotNet3" Version="3.6.0" />
    -->
    <PackageReference Include="ScriptHookVDotNet3" Version="3.6.0" />

    <!-- LemonUI - modern menu framework (works with both) -->
    <PackageReference Include="LemonUI.SHVDN3" Version="2.1.1" />

    <!-- JSON serialization for config files -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />

    <!-- Audio playback for the optional "Customize Radio" (plays the player's OWN mp3/wav files; none bundled) -->
    <PackageReference Include="NAudio" Version="1.10.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copy config file to output -->
    <None Update="ExtendedLSC.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Exclude local backup copies from the C# compile -->
  <ItemGroup>
    <Compile Remove="ExtendedLSC_backup_\**" />
    <Compile Remove="ExtendedLSC-backup-*\**" />
  </ItemGroup>

</Project>
